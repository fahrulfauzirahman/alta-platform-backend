FROM rust:1.78-slim AS builder
WORKDIR /app
COPY . .
RUN cargo build --release -p alta-api

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/alta-api /usr/local/bin/alta-api
EXPOSE 8080
CMD ["alta-api"]
